{
  "name": "personal-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test --project=ui",
    "test:ui:accessibility": "playwright test --project=ui tests/ui/accessibility.spec.mjs",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "node scripts/run-visual-tests.mjs --update-snapshots",
    "syntax:check": "{ find scripts -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0; find video-editor -maxdepth 1 -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0; } | xargs -0 -n1 node --check",
    "app-icons:check": "node scripts/build-app-icon-manifest.mjs --check",
    "study-resources:check": "node scripts/build-study-resources-manifest.mjs --check",
    "game-stats:integrity:check": "node scripts/update-game-integrity.mjs --check",
    "game-stats:deployment:local-check": "node scripts/check-game-stats-deployment.mjs",
    "game-stats:deployment:check": "node scripts/check-game-stats-deployment.mjs --live",
    "game-stats:static-release:check": "node scripts/check-game-stats-deployment.mjs --static-release",
    "game-stats:worker-transition:check": "node scripts/check-game-stats-deployment.mjs --worker-transition",
    "game-stats:release:check": "node scripts/check-game-stats-deployment.mjs --release",
    "game-stats:worker-secrets:check": "node scripts/check-game-stats-worker-secrets.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "yaml": "^2.9.0"
  }
}
